import React from 'react';
import { DocenteItem } from '../../types/orientacao';

interface DocenteCardProps {
  docente: DocenteItem;
  onSolicitar: (docente: DocenteItem) => void;
}

export const DocenteCard: React.FC<DocenteCardProps> = ({ docente, onSolicitar }) => {
  return (
    <div className="bg-white p-5 rounded-lg shadow-sm border space-y-3 hover:shadow-md transition">
      <div className="flex justify-between items-start">
        <div>
          <h3 className="text-lg font-bold text-gray-800">{docente.nome}</h3>
          <p className="text-xs text-gray-500">{docente.departamento} — {docente.email}</p>
        </div>
        <span className={`text-xs px-2.5 py-1 rounded-full font-semibold ${
          docente.vagas_disponiveis > 0 ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'
        }`}>
          {docente.vagas_disponiveis > 0 ? `${docente.vagas_disponiveis} vagas` : 'Sem vagas'}
        </span>
      </div>

      <div>
        <p className="text-xs font-semibold text-gray-500 mb-1">Áreas de Interesse:</p>
        <div className="flex flex-wrap gap-1.5">
          {docente.areas_interesse.map((area) => (
            <span key={area.id} className="text-xs px-2 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200">
              {area.nome}
            </span>
          ))}
        </div>
      </div>

      <div className="pt-2 flex justify-end">
        <button
          onClick={() => onSolicitar(docente)}
          disabled={docente.vagas_disponiveis === 0}
          className="bg-blue-600 text-white text-xs px-4 py-2 rounded font-medium hover:bg-blue-700 disabled:bg-gray-300 disabled:cursor-not-allowed"
        >
          Solicitar Orientação
        </button>
      </div>
    </div>
  );
};
