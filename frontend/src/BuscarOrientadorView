import React, { useEffect, useState } from 'react';
import { DocenteItem, AreaInteresse } from '../../types/orientacao';
import { buscarDocentes, getAreasInteresse, solicitarOrientacao } from '../../services/orientacaoService';
import { DocenteCard } from '../../components/orientacao/DocenteCard';

export const BuscarOrientadorView: React.FC = () => {
  const [docentes, setDocentes] = useState<DocenteItem[]>([]);
  const [areas, setAreas] = useState<AreaInteresse[]>([]);
  const [selectedArea, setSelectedArea] = useState('');
  const [search, setSearch] = useState('');
  const [loading, setLoading] = useState(false);

  // Modal de proposta
  const [selectedDocente, setSelectedDocente] = useState<DocenteItem | null>(null);
  const [titulo, setTitulo] = useState('');
  const [resumo, setResumo] = useState('');
  const [submitting, setSubmitting] = useState(false);

  useEffect(() => {
    getAreasInteresse().then(setAreas).catch(console.error);
    handleSearch();
  }, []);

  const handleSearch = async () => {
    setLoading(true);
    try {
      const data = await buscarDocentes(selectedArea, search);
      setDocentes(data);
    } catch (err) {
      console.error('Erro ao buscar orientadores:', err);
    } finally {
      setLoading(false);
    }
  };

  const handleEnviarProposta = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!selectedDocente || !titulo || !resumo) return;

    setSubmitting(true);
    try {
      await solicitarOrientacao(selectedDocente.id, titulo, resumo);
      alert('Solicitação de orientação enviada com sucesso!');
      setSelectedDocente(null);
      setTitulo('');
      setResumo('');
    } catch (err) {
      alert('Erro ao enviar solicitação de orientação.');
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div className="p-6 max-w-6xl mx-auto space-y-6">
      <div>
        <h1 className="text-2xl font-bold text-gray-800">Buscar Orientador (RAN18 / RAN19)</h1>
        <p className="text-sm text-gray-500">Pesquise professores por área de interesse e submeta a sua proposta de TCC</p>
      </div>

      {/* Filtros */}
      <div className="bg-white p-4 rounded-lg shadow-sm border flex flex-col sm:flex-row gap-4">
        <input
          type="text"
          placeholder="Nome do docente..."
          value={search}
          onChange={(e) => setSearch(e.target.value)}
          onKeyDown={(e) => e.key === 'Enter' && handleSearch()}
          className="flex-1 border rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
        <select
          value={selectedArea}
          onChange={(e) => setSelectedArea(e.target.value)}
          className="border rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          <option value="">Todas as Áreas de Interesse</option>
          {areas.map((area) => (
            <option key={area.id} value={area.id}>{area.nome}</option>
          ))}
        </select>
        <button
          onClick={handleSearch}
          className="bg-blue-600 text-white px-5 py-2 rounded text-sm font-medium hover:bg-blue-700"
        >
          Pesquisar
        </button>
      </div>

      {/* Lista de Docentes */}
      {loading ? (
        <div className="p-8 text-center text-gray-500">Buscando orientadores disponíveis...</div>
      ) : (
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          {docentes.map((docente) => (
            <DocenteCard
              key={docente.id}
              docente={docente}
              onSolicitar={(d) => setSelectedDocente(d)}
            />
          ))}
        </div>
      )}

      {/* Modal de Formulário de Proposta */}
      {selectedDocente && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50">
          <div className="bg-white rounded-lg shadow-xl w-full max-w-lg p-6 space-y-4">
            <h2 className="text-lg font-bold text-gray-800">
              Solicitar Orientação — {selectedDocente.nome}
            </h2>
            <form onSubmit={handleEnviarProposta} className="space-y-4 text-sm">
              <div>
                <label className="block font-medium text-gray-700 mb-1">Título Provisório da Proposta</label>
                <input
                  type="text"
                  required
                  value={titulo}
                  onChange={(e) => setTitulo(e.target.value)}
                  placeholder="Ex: Sistema de Gestão Escolar com Django e React"
                  className="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>

              <div>
                <label className="block font-medium text-gray-700 mb-1">Resumo da Proposta / Tema</label>
                <textarea
                  required
                  rows={4}
                  value={resumo}
                  onChange={(e) => setResumo(e.target.value)}
                  placeholder="Descreva brevemente o objetivo do seu TCC..."
                  className="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>

              <div className="flex justify-end gap-3 pt-2">
                <button
                  type="button"
                  onClick={() => setSelectedDocente(null)}
                  className="px-4 py-2 border rounded text-gray-600 hover:bg-gray-100"
                >
                  Cancelar
                </button>
                <button
                  type="submit"
                  disabled={submitting}
                  className="px-4 py-2 bg-blue-600 text-white rounded font-medium hover:bg-blue-700 disabled:bg-gray-400"
                >
                  {submitting ? 'Enviando...' : 'Enviar Solicitação'}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
};
