import React, { useEffect, useState } from 'react';
import { TccItem, TccDetalhes } from '../../types/tcc';
import { getTccsSecretaria, getTccDetalhes } from '../../services/tccService';
import { TccDetailModal } from '../../components/secretaria/TccDetailModal';

export const SecretariaTccView: React.FC = () => {
  const [tccs, setTccs] = useState<TccItem[]>([]);
  const [search, setSearch] = useState('');
  const [statusFilter, setStatusFilter] = useState('');
  const [selectedTcc, setSelectedTcc] = useState<TccDetalhes | null>(null);
  const [loading, setLoading] = useState(false);

  const fetchTccs = async () => {
    setLoading(true);
    try {
      const data = await getTccsSecretaria(search, statusFilter);
      setTccs(data);
    } catch (err) {
      console.error('Erro ao carregar TCCs para a secretária', err);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchTccs();
  }, [statusFilter]);

  const handleOpenDetail = async (id: string) => {
    try {
      const detalhes = await getTccDetalhes(id);
      setSelectedTcc(detalhes);
    } catch (err) {
      alert('Não foi possível carregar os detalhes do TCC.');
    }
  };

  return (
    <div className="p-6 max-w-7xl mx-auto space-y-6">
      <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
          <h1 className="text-2xl font-bold text-gray-800">Consulta Geral de TCCs — Secretária</h1>
          <p className="text-sm text-gray-500">Acesso irrestrito de leitura a todos os trabalhos (RD30)</p>
        </div>
      </div>

      {/* Filtros */}
      <div className="flex flex-col sm:flex-row gap-4 bg-white p-4 rounded-lg shadow-sm border">
        <input
          type="text"
          placeholder="Buscar por título ou nome do aluno..."
          value={search}
          onChange={(e) => setSearch(e.target.value)}
          onKeyDown={(e) => e.key === 'Enter' && fetchTccs()}
          className="flex-1 border rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
        <select
          value={statusFilter}
          onChange={(e) => setStatusFilter(e.target.value)}
          className="border rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          <option value="">Todos os Status</option>
          <option value="EM_ANDAMENTO">Em Andamento</option>
          <option value="DEFENDIDO">Defendido</option>
          <option value="CANCELADO">Cancelado</option>
        </select>
        <button
          onClick={fetchTccs}
          className="bg-blue-600 text-white px-4 py-2 rounded text-sm hover:bg-blue-700 font-medium"
        >
          Filtrar
        </button>
      </div>

      {/* Tabela de Resultados */}
      <div className="bg-white rounded-lg shadow overflow-hidden border">
        {loading ? (
          <div className="p-8 text-center text-gray-500">Carregando dados dos TCCs...</div>
        ) : (
          <table className="min-w-full divide-y divide-gray-200 text-sm">
            <thead className="bg-gray-50">
              <tr>
                <th className="px-6 py-3 text-left font-semibold text-gray-600">Título / Aluno</th>
                <th className="px-6 py-3 text-left font-semibold text-gray-600">Orientador</th>
                <th className="px-6 py-3 text-left font-semibold text-gray-600">Status</th>
                <th className="px-6 py-3 text-left font-semibold text-gray-600">Visibilidade</th>
                <th className="px-6 py-3 text-right font-semibold text-gray-600">Ação</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-gray-200">
              {tccs.map((tcc) => (
                <tr key={tcc.id} className="hover:bg-gray-50">
                  <td className="px-6 py-4">
                    <div className="font-medium text-gray-900">{tcc.titulo}</div>
                    <div className="text-xs text-gray-500">{tcc.aluno_nome} ({tcc.curso_nome})</div>
                  </td>
                  <td className="px-6 py-4 text-gray-700">{tcc.orientador_nome}</td>
                  <td className="px-6 py-4">
                    <span className={`px-2 py-1 text-xs font-semibold rounded ${
                      tcc.status === 'DEFENDIDO' ? 'bg-green-100 text-green-800' :
                      tcc.status === 'CANCELADO' ? 'bg-red-100 text-red-800' : 'bg-blue-100 text-blue-800'
                    }`}>
                      {tcc.status}
                    </span>
                  </td>
                  <td className="px-6 py-4">
                    <span className={`px-2 py-1 text-xs font-semibold rounded ${
                      tcc.visibilidade === 'RESTRITO' 
                        ? 'bg-amber-100 text-amber-800 border border-amber-300' 
                        : 'bg-gray-100 text-gray-700'
                    }`}>
                      {tcc.visibilidade}
                    </span>
                  </td>
                  <td className="px-6 py-4 text-right">
                    <button
                      onClick={() => handleOpenDetail(tcc.id)}
                      className="text-blue-600 hover:text-blue-900 font-medium text-xs border border-blue-200 px-3 py-1 rounded hover:bg-blue-50"
                    >
                      👁 Detalhes
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>

      {/* Modal de Detalhes */}
      <TccDetailModal tcc={selectedTcc} onClose={() => setSelectedTcc(null)} />
    </div>
  );
};
