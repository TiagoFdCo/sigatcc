import React from 'react';

interface StatCardsProps {
  totalTccs: number;
  emAndamento: number;
  defendidos: number;
  bancasAgendadas: number;
}

export const StatCards: React.FC<StatCardsProps> = ({
  totalTccs,
  emAndamento,
  defendidos,
  bancasAgendadas,
}) => {
  const cards = [
    { title: 'Total de TCCs', value: totalTccs, color: 'border-l-4 border-blue-500', bg: 'bg-blue-50' },
    { title: 'Em Andamento', value: emAndamento, color: 'border-l-4 border-amber-500', bg: 'bg-amber-50' },
    { title: 'Defendidos', value: defendidos, color: 'border-l-4 border-green-500', bg: 'bg-green-50' },
    { title: 'Bancas Próximas', value: bancasAgendadas, color: 'border-l-4 border-purple-500', bg: 'bg-purple-50' },
  ];

  return (
    <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {cards.map((card, idx) => (
        <div key={idx} className={`bg-white p-4 rounded-lg shadow-sm border ${card.color}`}>
          <p className="text-xs font-semibold text-gray-500 uppercase tracking-wider">{card.title}</p>
          <p className="text-2xl font-bold text-gray-800 mt-1">{card.value}</p>
        </div>
      ))}
    </div>
  );
};
