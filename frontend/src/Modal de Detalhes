          <div>
            <h2 className="text-xl font-bold text-gray-800">{tcc.titulo}</h2>
            <span className="text-xs px-2 py-1 rounded bg-purple-100 text-purple-800 font-semibold mt-1 inline-block">
              Visibilidade: {tcc.visibilidade.replace(/_/g, ' ')}
            </span>
          </div>
          <button onClick={onClose} className="text-gray-400 hover:text-gray-600 font-bold text-xl">
            &times;
          </button>
        </div>

        <div className="space-y-4 text-sm text-gray-700">
          <div className="grid grid-cols-2 gap-4 bg-gray-50 p-3 rounded">
            <div>
              <p className="font-semibold text-gray-500">Aluno</p>
              <p>{tcc.aluno_nome}</p>
              <p className="text-xs text-gray-400">CPF: {tcc.aluno_cpf}</p>
            </div>
            <div>
              <p className="font-semibold text-gray-500">Orientador</p>
              <p>{tcc.orientador_nome}</p>
              {tcc.coorientador_nome && <p className="text-xs text-gray-500">Co: {tcc.coorientador_nome}</p>}
            </div>
          </div>

          <div>
            <p className="font-semibold text-gray-500">Curso / Status</p>
            <p>{tcc.curso_nome} — <span className="font-medium text-blue-600">{tcc.status}</span></p>
