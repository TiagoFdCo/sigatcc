          <div>
            <p className="font-semibold text-gray-500">Resumo</p>
            <p className="text-gray-600 text-justify mt-1">{tcc.resumo || 'Sem resumo cadastrado.'}</p>
          </div>

          {tcc.membros_banca.length > 0 && (
            <div>
              <p className="font-semibold text-gray-500">Membros da Banca (3 Titulares)</p>
              <ul className="list-disc list-inside text-xs mt-1">
                {tcc.membros_banca.map((membro, i) => (
                  <li key={i}>{membro}</li>
