# Copie este arquivo para ".env" e preencha com valores reais.
# O ".env" nunca deve ser commitado (ja esta no .gitignore).

# --- Banco de dados (Postgres) ---
DB_NAME=sigatcc
DB_USER=sigatcc_user
DB_PASSWORD=troque_esta_senha

# --- Django ---
DJANGO_SECRET_KEY=troque_por_uma_chave_aleatoria_longa
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Autenticacao JWT ---
JWT_SIGNING_KEY=troque_por_outra_chave_aleatoria_longa

# --- CORS (dominio da SPA autorizado a chamar a API) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- E-mail transacional (Resend) ---
RESEND_API_KEY=coloque_sua_chave_do_resend
