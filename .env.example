# Copie este arquivo para ".env" e preencha com valores reais.
# O ".env" nunca deve ser commitado (ja esta no .gitignore).

# --- Banco de dados local (desenvolvimento, container "db") ---
DB_NAME=sigatcc
DB_USER=sigatcc_user
DB_PASSWORD=troque_esta_senha

# --- Banco em producao (PostgreSQL gerenciado da DigitalOcean) ---
# Em desenvolvimento esta linha e ignorada: o compose monta a URL do container "db".
# DATABASE_URL=postgres://usuario:senha@host-do-banco:25060/sigatcc?sslmode=require

# --- Django ---
DJANGO_SECRET_KEY=troque_por_uma_chave_aleatoria_longa
# True so em desenvolvimento. Em producao, False.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Autenticacao JWT (usada a partir do B5) ---
JWT_SIGNING_KEY=troque_por_outra_chave_aleatoria_longa

# --- CORS (dominio da SPA autorizado a chamar a API) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (B9a): endereco da API visto pelo navegador ---
VITE_API_URL=http://localhost:8000/api

# --- E-mail transacional (Resend) ---
RESEND_API_KEY=coloque_sua_chave_do_resend
